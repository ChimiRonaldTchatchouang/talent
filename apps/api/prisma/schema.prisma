// Schéma de la base Bassin de Talents.
// Lot 1 : comptes, sessions, journal, listes de référence, paramètres du classement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECTE")
}

enum Role {
  CANDIDAT
  ADMIN
  RECRUTEUR
}

enum EtatCompte {
  ACTIF
  DESACTIVE
}

enum StatutCompetence {
  VALIDEE
  PROPOSEE
  REJETEE
}

enum ElementComblable {
  TEST_LANGUE
  COACHING
  NIVEAU
}

model Utilisateur {
  id                 String     @id @default(uuid()) @db.Uuid
  role               Role
  nom                String?
  email              String?    @unique
  telephone          String?    @unique
  motDePasseHash     String     @map("mot_de_passe_hash")
  etat               EtatCompte @default(ACTIF)
  estPrincipal       Boolean    @default(false) @map("est_principal")
  emailVerifieLe     DateTime?  @map("email_verifie_le")
  tentativesEchouees Int        @default(0) @map("tentatives_echouees")
  bloqueJusquA       DateTime?  @map("bloque_jusqu_a")
  derniereConnexion  DateTime?  @map("derniere_connexion")
  creeLe             DateTime   @default(now()) @map("cree_le")
  modifieLe          DateTime   @updatedAt @map("modifie_le")
  creeParId          String?    @map("cree_par_id") @db.Uuid

  sessions             Session[]
  dossier              Dossier?
  jetons               Jeton[]
  competencesProposees Competence[]           @relation("CompetenceProposee")
  versionsParametres   ParametresClassement[]
  accesRecruteur       AccesRecruteur?

  @@map("utilisateurs")
}

model Session {
  // Empreinte SHA-256 du jeton : le jeton lui-même n'est jamais stocké.
  id            String      @id
  utilisateurId String      @map("utilisateur_id") @db.Uuid
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  expireLe      DateTime    @map("expire_le")
  creeLe        DateTime    @default(now()) @map("cree_le")

  @@index([utilisateurId])
  @@map("sessions")
}

/// Journal des actions. Ajout seulement : un déclencheur SQL refuse toute modification ou suppression.
model Journal {
  id        BigInt   @id @default(autoincrement())
  acteurId  String?  @map("acteur_id") @db.Uuid
  role      Role?
  action    String
  cibleType String?  @map("cible_type")
  cibleId   String?  @map("cible_id")
  details   Json?
  ip        String?
  creeLe    DateTime @default(now()) @map("cree_le")

  @@index([creeLe])
  @@index([cibleType, cibleId])
  @@map("journal")
}

model Domaine {
  id          String       @id @default(uuid()) @db.Uuid
  nom         String       @unique
  actif       Boolean      @default(true)
  creeLe      DateTime     @default(now()) @map("cree_le")
  modifieLe   DateTime     @updatedAt @map("modifie_le")
  competences Competence[]
  dossiers    Dossier[]

  @@map("domaines")
}

model Competence {
  id            String           @id @default(uuid()) @db.Uuid
  nom           String
  domaineId     String           @map("domaine_id") @db.Uuid
  domaine       Domaine          @relation(fields: [domaineId], references: [id])
  statut        StatutCompetence @default(VALIDEE)
  actif         Boolean          @default(true)
  proposeeParId String?          @map("proposee_par_id") @db.Uuid
  proposeePar   Utilisateur?     @relation("CompetenceProposee", fields: [proposeeParId], references: [id], onDelete: SetNull)
  creeLe        DateTime         @default(now()) @map("cree_le")
  modifieLe     DateTime         @updatedAt @map("modifie_le")

  dossiers DossierCompetence[]

  @@unique([domaineId, nom])
  @@index([statut])
  @@map("competences")
}

model TestLangue {
  id           String    @id @default(uuid()) @db.Uuid
  nom          String    @unique
  /// Score minimum accepté. Vide : pas de comparaison automatique (vérification par l'administrateur).
  scoreMinimum Decimal?  @map("score_minimum") @db.Decimal(7, 1)
  actif        Boolean   @default(true)
  creeLe       DateTime  @default(now()) @map("cree_le")
  modifieLe    DateTime  @updatedAt @map("modifie_le")
  dossiers     Dossier[]

  @@map("tests_langue")
}

model Service {
  id            String            @id @default(uuid()) @db.Uuid
  nom           String            @unique
  description   String            @default("")
  duree         String            @default("")
  elementComble ElementComblable? @map("element_comble")
  actif         Boolean           @default(true)
  creeLe        DateTime          @default(now()) @map("cree_le")
  modifieLe     DateTime          @updatedAt @map("modifie_le")
  candidats     ServiceCandidat[]

  @@map("services")
}

model Diplome {
  id        String    @id @default(uuid()) @db.Uuid
  nom       String    @unique
  ordre     Int
  actif     Boolean   @default(true)
  creeLe    DateTime  @default(now()) @map("cree_le")
  modifieLe DateTime  @updatedAt @map("modifie_le")
  dossiers  Dossier[]

  @@map("diplomes")
}

/// Chaque modification crée une nouvelle version ; la plus récente est en vigueur.
model ParametresClassement {
  id        Int          @id @default(autoincrement())
  valeurs   Json
  creeParId String?      @map("cree_par_id") @db.Uuid
  creePar   Utilisateur? @relation(fields: [creeParId], references: [id], onDelete: SetNull)
  creeLe    DateTime     @default(now()) @map("cree_le")

  @@map("parametres_classement")
}

// ---------- Lot 2 : espace candidat ----------

enum StatutDossier {
  BROUILLON
  ENVOYE
}

enum Sexe {
  FEMME
  HOMME
}

enum TrancheExperience {
  ANS_0_2
  ANS_3_5
  ANS_6_10
  ANS_10_PLUS
}

enum NiveauBureautique {
  DEBUTANT
  MOYEN
  BON
}

enum Situation {
  CELIBATAIRE
  MARIE
  UNION_LIBRE
  AUTRE
}

enum Enfants {
  AUCUN
  UN
  DEUX
  TROIS_PLUS
}

enum TypePiece {
  IDENTITE
  DIPLOME
  ATTESTATION_LANGUE
  CERTIFICAT_TRAVAIL
  CV
}

enum EtatPiece {
  DEPOSEE
  VERIFIEE
  REFUSEE
}

enum TypeJeton {
  CONFIRMATION_EMAIL
  REINITIALISATION
}

enum StatutEmail {
  ENVOYE
  ECHEC
  DEMO
}

/// Dossier du candidat. Les réponses d'une section masquée (filtre passé à Non) sont conservées
/// mais ignorées ; elles réapparaissent si le filtre repasse à Oui.
model Dossier {
  id                       String        @id @default(uuid()) @db.Uuid
  utilisateurId            String        @unique @map("utilisateur_id") @db.Uuid
  utilisateur              Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  statut                   StatutDossier @default(BROUILLON)
  derniereEtape            String?       @map("derniere_etape")
  envoyeLe                 DateTime?     @map("envoye_le")
  certifieLe               DateTime?     @map("certifie_le")
  consentementTraitementLe DateTime      @map("consentement_traitement_le")
  consentementRecruteursLe DateTime?     @map("consentement_recruteurs_le")

  // Informations personnelles
  nom                 String?
  prenoms             String?
  dateNaissance       DateTime? @map("date_naissance") @db.Date
  sexe                Sexe?
  nationalite         String?
  ville               String?
  telephoneContact    String?   @map("telephone_contact")
  emailContact        String?   @map("email_contact")
  languesParlees      String[]  @default([]) @map("langues_parlees")
  aPasseport          Boolean?  @map("a_passeport")
  passeportExpiration DateTime? @map("passeport_expiration") @db.Date

  // Études
  aDiplome        Boolean? @map("a_diplome")
  diplomeId       String?  @map("diplome_id") @db.Uuid
  diplome         Diplome? @relation(fields: [diplomeId], references: [id])
  diplomeIntitule String?  @map("diplome_intitule")
  filiere         String?
  etablissement   String?
  diplomeAnnee    Int?     @map("diplome_annee")
  diplomePays     String?  @map("diplome_pays")

  // Langues
  aTestLangue  Boolean?    @map("a_test_langue")
  testLangueId String?     @map("test_langue_id") @db.Uuid
  testLangue   TestLangue? @relation(fields: [testLangueId], references: [id])
  testScore    Decimal?    @map("test_score") @db.Decimal(7, 1)
  testDate     DateTime?   @map("test_date") @db.Date

  // Expérience professionnelle
  aTravaille        Boolean?           @map("a_travaille")
  domaineId         String?            @map("domaine_id") @db.Uuid
  domaine           Domaine?           @relation(fields: [domaineId], references: [id])
  metier            String?
  trancheExperience TrancheExperience? @map("tranche_experience")
  bureautique       NiveauBureautique?

  // Situation familiale
  situation             Situation?
  conjointNom           String?    @map("conjoint_nom")
  conjointProfession    String?    @map("conjoint_profession")
  conjointPasseport     Boolean?   @map("conjoint_passeport")
  enfants               Enfants?
  partAvecAccompagnants Boolean?   @map("part_avec_accompagnants")
  nombreAccompagnants   Int?       @map("nombre_accompagnants")

  creeLe    DateTime @default(now()) @map("cree_le")
  modifieLe DateTime @updatedAt @map("modifie_le")

  // Évaluation du niveau dans le domaine par l'administrateur (M8)
  niveauEvalue      NiveauEvalue @default(NON_EVALUE) @map("niveau_evalue")
  niveauEvalueLe    DateTime?    @map("niveau_evalue_le")
  niveauEvalueParId String?      @map("niveau_evalue_par_id") @db.Uuid

  experiences            Experience[]
  competences            DossierCompetence[]
  pieces                 Piece[]
  grade                  GradeDossier?
  historiqueGrades       GradeHistorique[]
  services               ServiceCandidat[]
  noteInternes           NoteInterne[]
  selectionLignes        SelectionLigne[]
  selectionEnvoyeeLignes SelectionEnvoyeeLigne[]
  consultationRecruteurs ConsultationRecruteur[]

  @@index([statut])
  @@map("dossiers")
}

model Experience {
  id        String  @id @default(uuid()) @db.Uuid
  dossierId String  @map("dossier_id") @db.Uuid
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  ordre     Int
  employeur String
  poste     String
  debut     String?
  fin       String?
  ville     String?

  @@index([dossierId])
  @@map("experiences")
}

model DossierCompetence {
  dossierId    String     @map("dossier_id") @db.Uuid
  dossier      Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  competenceId String     @map("competence_id") @db.Uuid
  competence   Competence @relation(fields: [competenceId], references: [id])

  @@id([dossierId, competenceId])
  @@map("dossier_competences")
}

model Piece {
  id           String           @id @default(uuid()) @db.Uuid
  dossierId    String           @map("dossier_id") @db.Uuid
  dossier      Dossier          @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type         TypePiece
  etat         EtatPiece        @default(DEPOSEE)
  motifRefus   String?          @map("motif_refus")
  fichierId    String           @unique @map("fichier_id") @db.Uuid
  fichier      Fichier          @relation(fields: [fichierId], references: [id])
  nomFichier   String           @map("nom_fichier")
  deposeLe     DateTime         @default(now()) @map("depose_le")
  verifieLe    DateTime?        @map("verifie_le")
  verifieParId String?          @map("verifie_par_id") @db.Uuid
  evenements   PieceEvenement[]

  @@index([dossierId])
  @@index([etat])
  @@map("pieces")
}

/// Historique d'une pièce (dépôts, refus avec motif, vérifications).
model PieceEvenement {
  id       BigInt    @id @default(autoincrement())
  pieceId  String    @map("piece_id") @db.Uuid
  piece    Piece     @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  etat     EtatPiece
  motif    String?
  acteurId String?   @map("acteur_id") @db.Uuid
  creeLe   DateTime  @default(now()) @map("cree_le")

  @@index([pieceId])
  @@map("pieces_evenements")
}

/// Fichiers déposés : stockés en base, privés, servis uniquement par lien temporaire signé.
model Fichier {
  id        String   @id @default(uuid()) @db.Uuid
  contenu   Bytes
  typeMime  String   @map("type_mime")
  taille    Int
  empreinte String
  creeLe    DateTime @default(now()) @map("cree_le")
  piece     Piece?

  @@map("fichiers")
}

/// Jeton à usage unique (confirmation d'e-mail, réinitialisation du mot de passe). Seule l'empreinte est stockée.
model Jeton {
  id            String      @id
  type          TypeJeton
  utilisateurId String      @map("utilisateur_id") @db.Uuid
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  expireLe      DateTime    @map("expire_le")
  utiliseLe     DateTime?   @map("utilise_le")
  creeLe        DateTime    @default(now()) @map("cree_le")

  @@index([utilisateurId])
  @@map("jetons")
}

/// Journal des e-mails (M10). En mode démo (sans clé Resend), l'e-mail n'est pas envoyé, seulement écrit ici.
model EmailEnvoye {
  id           String      @id @default(uuid()) @db.Uuid
  destinataire String
  sujet        String
  texte        String
  statut       StatutEmail
  erreur       String?
  creeLe       DateTime    @default(now()) @map("cree_le")

  @@index([creeLe])
  @@map("emails")
}

/// Réglages de la plateforme modifiables par l'administrateur (ex. téléphone du cabinet).
model Reglage {
  cle       String   @id
  valeur    Json
  modifieLe DateTime @updatedAt @map("modifie_le")

  @@map("reglages")
}

// ---------- Lot 3 : classement ----------

enum NiveauEvalue {
  NON_EVALUE
  INSUFFISANT
  SUFFISANT
}

enum ValeurGrade {
  A
  B
  C
  D
  HORS_BASSIN
}

enum EtatGrade {
  PROVISOIRE
  CONFIRME
  CORRIGE
}

enum EtatService {
  SUGGERE
  INTERESSE
  ACCEPTE
  EN_COURS
  REALISE
  ANNULE
}

/// Grade actuel d'un dossier (R-06 : un seul grade à la fois).
model GradeDossier {
  dossierId      String      @id @map("dossier_id") @db.Uuid
  dossier        Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  /// Grade calculé par le moteur (toujours à jour).
  gradeCalcule   ValeurGrade @map("grade_calcule")
  /// Grade affiché : le grade calculé, ou le grade corrigé par l'administrateur.
  grade          ValeurGrade
  etat           EtatGrade   @default(PROVISOIRE)
  regle          String
  explication    Json
  suggestions    String[]    @default([])
  /// Éléments « faits » (vérifiés ou réalisés) et éléments acquis pour le grade provisoire.
  elementsFaits  String[]    @default([]) @map("elements_faits")
  elementsAcquis String[]    @default([]) @map("elements_acquis")
  raison         String?
  auteurId       String?     @map("auteur_id") @db.Uuid
  /// Grade confirmé ou corrigé remis en provisoire par une modification du candidat : à revoir.
  alerte         Boolean     @default(false)
  calculeLe      DateTime    @default(now()) @map("calcule_le")
  modifieLe      DateTime    @updatedAt @map("modifie_le")

  @@index([grade, etat])
  @@map("grades")
}

/// Historique complet des grades (calculs, confirmations, corrections).
model GradeHistorique {
  id           BigInt      @id @default(autoincrement())
  dossierId    String      @map("dossier_id") @db.Uuid
  dossier      Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  grade        ValeurGrade
  gradeCalcule ValeurGrade @map("grade_calcule")
  etat         EtatGrade
  cause        String
  raison       String?
  auteurId     String?     @map("auteur_id") @db.Uuid
  creeLe       DateTime    @default(now()) @map("cree_le")

  @@index([dossierId])
  @@map("grades_historique")
}

/// Service du cabinet pour un candidat (M6). Sans ligne : le service est seulement « suggéré ».
model ServiceCandidat {
  id          String      @id @default(uuid()) @db.Uuid
  dossierId   String      @map("dossier_id") @db.Uuid
  dossier     Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  serviceId   String      @map("service_id") @db.Uuid
  service     Service     @relation(fields: [serviceId], references: [id])
  etat        EtatService
  interesseLe DateTime?   @map("interesse_le")
  accepteLe   DateTime?   @map("accepte_le")
  enCoursLe   DateTime?   @map("en_cours_le")
  realiseLe   DateTime?   @map("realise_le")
  annuleLe    DateTime?   @map("annule_le")
  creeLe      DateTime    @default(now()) @map("cree_le")
  modifieLe   DateTime    @updatedAt @map("modifie_le")

  @@unique([dossierId, serviceId])
  @@index([etat])
  @@map("services_candidats")
}

// ---------- Lot 4 : espace administrateur ----------

/// Notes internes du cabinet sur un dossier (jamais visibles par le candidat ni le recruteur).
model NoteInterne {
  id        String   @id @default(uuid()) @db.Uuid
  dossierId String   @map("dossier_id") @db.Uuid
  dossier   Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auteurId  String?  @map("auteur_id") @db.Uuid
  texte     String
  creeLe    DateTime @default(now()) @map("cree_le")

  @@index([dossierId])
  @@map("notes_internes")
}

// ---------- Lot 5 : espace recruteur ----------

enum StatutLigneSelection {
  A_CONTACTER
  MIS_EN_RELATION
  RETENU
  NON_RETENU
}

/// Accès limité d'un recruteur invité (M9). Toujours une date de fin (R-16).
model AccesRecruteur {
  id               String        @id @default(uuid()) @db.Uuid
  utilisateurId    String        @unique @map("utilisateur_id") @db.Uuid
  utilisateur      Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  entreprise       String
  pays             String
  /// Périmètre : grades visibles (au moins un) et domaines visibles (vide = tous les domaines).
  gradesVisibles   ValeurGrade[] @map("grades_visibles")
  domainesVisibles String[]      @default([]) @map("domaines_visibles")
  /// Dernier jour d'accès (inclus).
  dateFin          DateTime      @map("date_fin") @db.Date
  alerteFinEnvoyee Boolean       @default(false) @map("alerte_fin_envoyee")
  creeParId        String?       @map("cree_par_id") @db.Uuid
  creeLe           DateTime      @default(now()) @map("cree_le")
  modifieLe        DateTime      @updatedAt @map("modifie_le")

  selection     Selection?
  envois        SelectionEnvoyee[]
  consultations ConsultationRecruteur[]

  @@map("acces_recruteurs")
}

/// Sélection en cours de préparation par le recruteur (une seule par accès).
model Selection {
  id        String           @id @default(uuid()) @db.Uuid
  accesId   String           @unique @map("acces_id") @db.Uuid
  acces     AccesRecruteur   @relation(fields: [accesId], references: [id], onDelete: Cascade)
  message   String           @default("")
  modifieLe DateTime         @updatedAt @map("modifie_le")
  lignes    SelectionLigne[]

  @@map("selections")
}

model SelectionLigne {
  selectionId String    @map("selection_id") @db.Uuid
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  dossierId   String    @map("dossier_id") @db.Uuid
  dossier     Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  commentaire String    @default("")
  ajouteLe    DateTime  @default(now()) @map("ajoute_le")

  @@id([selectionId, dossierId])
  @@map("selections_lignes")
}

/// Sélection envoyée au cabinet. Un nouvel envoi remplace le précédent, qui reste dans l'historique.
model SelectionEnvoyee {
  id          String                  @id @default(uuid()) @db.Uuid
  accesId     String                  @map("acces_id") @db.Uuid
  acces       AccesRecruteur          @relation(fields: [accesId], references: [id], onDelete: Cascade)
  message     String                  @default("")
  envoyeeLe   DateTime                @default(now()) @map("envoyee_le")
  remplaceeLe DateTime?               @map("remplacee_le")
  lignes      SelectionEnvoyeeLigne[]

  @@index([accesId])
  @@map("selections_envoyees")
}

model SelectionEnvoyeeLigne {
  id          String               @id @default(uuid()) @db.Uuid
  envoiId     String               @map("envoi_id") @db.Uuid
  envoi       SelectionEnvoyee     @relation(fields: [envoiId], references: [id], onDelete: Cascade)
  dossierId   String               @map("dossier_id") @db.Uuid
  dossier     Dossier              @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  commentaire String               @default("")
  statut      StatutLigneSelection @default(A_CONTACTER)
  modifieLe   DateTime             @updatedAt @map("modifie_le")

  @@index([envoiId])
  @@map("selections_envoyees_lignes")
}

/// Fiche consultée par un recruteur (M11 : le candidat voit le nombre et la date, sans le nom de l'entreprise).
model ConsultationRecruteur {
  id        BigInt         @id @default(autoincrement())
  accesId   String         @map("acces_id") @db.Uuid
  acces     AccesRecruteur @relation(fields: [accesId], references: [id], onDelete: Cascade)
  dossierId String         @map("dossier_id") @db.Uuid
  dossier   Dossier        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  creeLe    DateTime       @default(now()) @map("cree_le")

  @@index([dossierId])
  @@map("consultations_recruteurs")
}
