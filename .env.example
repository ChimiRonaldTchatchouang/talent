# Exemple de variables d'environnement. Copier en .env (jamais versionné) et remplir.
# Aucune valeur secrète dans ce fichier.

# ---------- API (apps/api/.env, ou Render) ----------
# Base de données. Pour Neon : la chaîne « pooled » (avec -pooler). L'API joint Neon par WebSocket
# sur le port 443 ; migrations, application et initialisation utilisent toutes cette seule variable.
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxx-pooler.c-0.region.aws.neon.tech/neondb?sslmode=require
# Uniquement en développement, pour créer une migration avec « prisma migrate dev » (connexion directe, port 5432).
DATABASE_URL_DIRECTE=postgresql://postgres:postgres@localhost:5432/bdt_dev
PORT=4000
# Adresse publique du site (liens des e-mails, CORS).
URL_SITE=http://localhost:3000
# Compte administrateur principal, créé au premier démarrage s'il n'existe pas (12 caractères minimum).
ADMIN_PRINCIPAL_EMAIL=
ADMIN_PRINCIPAL_MOT_DE_PASSE=
ADMIN_PRINCIPAL_NOM=
# Adresse publique de l'API (dépôt direct des fichiers). Sur Render, inutile : RENDER_EXTERNAL_URL est fournie.
URL_API_PUBLIQUE=
# Clé de signature des liens temporaires (32 caractères minimum). Facultative : créée automatiquement en base sinon.
SECRET_LIENS=
# Limitation des tentatives de connexion.
CONNEXION_ESSAIS_MAX=5
CONNEXION_BLOCAGE_MINUTES=15
# E-mails : clé Resend et adresse d'expédition (ex. « Bassin de Talents <contact@domaine.cm> »).
# Vides = mode démo : les e-mails ne partent pas, ils sont listés dans Admin → Réglages.
RESEND_API_KEY=
EMAIL_EXPEDITEUR=

# ---------- Site (apps/web/.env, ou Vercel) ----------
# Adresse de l'API, utilisée par Next pour relayer /api/… (lue au moment du build).
URL_API=http://localhost:4000

# ---------- Tests ----------
TEST_DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/postgres
